# Dev on the go — configuration plateforme
DOMAIN=dev.example.com
ACME_EMAIL=admin@example.com

# Admin initial (créé au premier démarrage si aucun utilisateur)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# Plateforme AdonisJS
APP_KEY=
APP_URL=https://admin.dev.example.com
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
SESSION_DRIVER=cookie

# Base de données (sqlite par défaut, libsql optionnel)
DB_CONNECTION=sqlite
DB_DATABASE=/app/data/db.sqlite3
# LIBSQL_URL=file:/app/data/db.sqlite3
# LIBSQL_AUTH_TOKEN=

# Docker
DOCKER_NETWORK=devonthego
DOCKER_REGISTRY=registry:5000
ENV_IMAGE_PREFIX=devonthego
ENV_CPU_LIMIT=1
ENV_MEMORY_LIMIT=1024m
ENV_WORKSPACE_PATH=/data/workspaces

# Inscription publique (false en production)
ALLOW_PUBLIC_SIGNUP=false
