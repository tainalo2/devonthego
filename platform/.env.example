# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:3333
DOMAIN=localhost
ALLOW_PUBLIC_SIGNUP=true

# Session
SESSION_DRIVER=cookie

# Database (sqlite par défaut, libsql optionnel)
DB_CONNECTION=sqlite
DB_DATABASE=tmp/db.sqlite3
# DB_CONNECTION=libsql
# LIBSQL_URL=file:tmp/db.sqlite3

# Docker (production)
# DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_NETWORK=devonthego
# DOCKER_REGISTRY=registry:5000
# ENV_WORKSPACE_PATH=/data/workspaces

# Bootstrap admin (production)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME=Administrator
